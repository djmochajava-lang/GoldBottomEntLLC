rules_version = '2';

// Gold Bottom Ent. LLC — Firebase Storage Security Rules
// Protects band rehearsal media (audio, charts, artwork) as intellectual property.
// Deploy with: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // ── Band Media: Audio Files ──────────────────
    match /band-media/audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }

    // ── Band Media: Instrument Charts ────────────
    match /band-media/charts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }

    // ── Band Media: Playlist Artwork ─────────────
    match /band-media/artwork/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024;
    }

    // ── Default: Deny Everything Else ────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
